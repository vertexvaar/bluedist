{% if pagination.getTotalPages() > 1 %}
    <nav class="pagination">
        {% for page in 1..pagination.getTotalPages() %}
            {% if page == pagination.currentPage %}
                <span class="current">{{ page }}</span>
            {% else %}
                <a href="/listFruits?page={{ page }}">{{ page }}</a>
            {% endif %}
        {% endfor %}
    </nav>
{% endif %}
