{# @var element \VerteXVaaR\BlueForm\Element\FormElement #}

{% set label %}
    <label class="label" for="{{ element.name }}">{{ element.label }}</label>
{% endset %}

{% set content %}
    <input
            id="{{ element.name }}"
            class="input {% if element.validationErrors.errors %}is-danger{% endif %}"
            type="text"
            name="{{ element.htmlPathString }}"
            value="{{ element.value }}"
           {% if element.placeholder %}placeholder="{{ element.placeholder }}"{% endif %}
           {% if element.disabled %}disabled{% endif %}
           {% if element.readonly %}readonly{% endif %}
            autocomplete="{{ element.name }}"
    >
{% endset %}

{% set errors %}
    {% if element.validationErrors.errors %}
        {% for validationError in element.validationErrors.errors %}
            <p class="help is-danger">{{ validationError.label|t }}</p>
        {% endfor %}
    {% endif %}
{% endset %}

{% if element.icon %}
    {{ include('@vertexvaar_blueform/wrapper/icon.html.twig') }}
{% else %}
    {{ include('@vertexvaar_blueform/wrapper/none.html.twig') }}
{% endif %}
