{% macro render_data(data) %}
    {% if data is iterable %}
        <table class="nested-data">
            {% for key, value in data %}
                <tr>
                    <th class="nested-key">{{ key|raw }}</th>
                    <td class="nested-val">
                        {{ _self.render_data(value) }}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        {% if data is string and data matches '/^[{[]/' %}
            {% set decoded = data|json_decode %}
            {% if decoded is not same as(null) %}
                {{ _self.render_data(decoded) }}
            {% else %}
                <pre class="val-json">{{ data|raw }}</pre>
            {% endif %}
        {% else %}
            {% set encoded = data|json_encode(constant('JSON_PRETTY_PRINT')) %}
            {% if encoded matches '/^[{[]/' %}
                <pre class="val-json">{{ encoded|replace({'\\/': '/'})|raw }}</pre>
            {% else %}
                {% set type = data is same as(null) ? 'null' : (data is same as(true) or data is same as(false) ? 'boolean' : 'string') %}
                <span class="val-{{ type }}">
                    {% if type == 'null' %}null
                    {% elseif type == 'boolean' %}{{ data ? 'true' : 'false' }}
                    {% else %}{{ encoded|raw }}{% endif %}
                </span>
            {% endif %}
        {% endif %}
    {% endif %}
{% endmacro %}

<div id="blue-debug-toolbar-host-{{ requestId }}">
    <template shadowrootmode="open">
        <style>
            :host {
                all: initial;
                display: block;
                position: fixed;
                z-index: 2147483647;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
                font-size: 13px;
                line-height: 1.4;
                box-sizing: border-box;
            }

            :host(.pos-bottom) { bottom: 0; left: 0; right: 0; width: 100%; height: auto; }
            :host(.pos-top) { top: 0; left: 0; right: 0; width: 100%; height: auto; }
            :host(.pos-right) { top: 0; right: 0; bottom: 0; height: 100%; width: 350px; }
            :host(.pos-left) { top: 0; left: 0; bottom: 0; height: 100%; width: 350px; }

            .flexbox-panel {
                position: relative;
                width: 100%;
                height: 100%;
                background-color: #222222;
                color: #dddddd;
                display: flex;
                gap: 0;
                box-sizing: border-box;
            }

            :host(.pos-bottom) .flexbox-panel,
            :host(.pos-top) .flexbox-panel {
                flex-direction: row;
                flex-wrap: nowrap;
                justify-content: flex-start;
                align-items: center;
                padding: 0 10px;
                height: 35px;
                overflow-x: auto;
                overflow-y: hidden;
            }

            :host(.pos-right) .flexbox-panel,
            :host(.pos-left) .flexbox-panel {
                flex-direction: column;
                justify-content: flex-start;
                align-items: flex-start;
                overflow: auto;
            }

            .flexbox-item {
                flex: 0 0 auto;
                position: relative;
                cursor: pointer;
            }

            :host(.pos-bottom) .flexbox-item,
            :host(.pos-top) .flexbox-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 0 12px;
                height: 100%;
                white-space: nowrap;
                border-right: 1px solid #333333;
            }

            :host(.pos-right) .flexbox-item,
            :host(.pos-left) .flexbox-item {
                display: block;
                border-bottom: 1px solid #333333;
                padding: 12px;
                cursor: default;
                width: 100%;
                box-sizing: border-box;
            }

            .flexbox-item:hover, .flexbox-item.active {
                background-color: #2a2a2a;
            }

            .flexbox-item.locked {
                background-color: #333333;
                box-shadow: inset 0 0 5px rgba(0,0,0,0.5);
            }

            .infobox {
                visibility: hidden;
                opacity: 0;
                position: absolute;
                background-color: #2a2a2a;
                padding: 15px;
                border-radius: 4px;
                z-index: 10001;
                box-shadow: 0 4px 20px rgba(0,0,0,0.8);
                transition: opacity 0.2s ease-in-out;
                border: 1px solid #444444;
            }

            .flexbox-item.active .infobox {
                visibility: visible;
                opacity: 1;
            }

            .infobox table, .infobox tbody {
                display: block;
                width: 100%;
            }

            .infobox tr {
                display: flex;
                flex-flow: row wrap;
                width: 100%;
                border-bottom: 1px solid #333;
            }

            .infobox tr:last-child {
                border-bottom: none;
            }

            .infobox th {
                flex: 1 1 200px;
                max-width: 100%;
                padding: 4px 10px;
                background-color: rgba(255, 255, 255, 0.03);
            }

            .infobox td {
                flex: 10 1 400px;
                max-width: 100%;
                padding: 4px 10px;
                min-width: 0;
            }

            :host(.pos-bottom) .infobox { position: fixed; bottom: 35px; left: 50%; transform: translateX(-50%); }
            :host(.pos-top) .infobox { position: fixed; top: 35px; left: 50%; transform: translateX(-50%); }

            :host(.pos-bottom) .infobox,
            :host(.pos-top) .infobox {
                width: 95vw;
                max-width: 1600px;
                min-width: 450px;
                max-height: 85vh;
                overflow: auto;
                box-sizing: border-box;
            }

            :host(.pos-right) .infobox,
            :host(.pos-left) .infobox {
                visibility: visible;
                opacity: 1;
                position: static;
                display: block;
                box-shadow: none;
                background-color: transparent;
                padding: 8px 0 0 0;
                max-height: none;
                overflow: visible;
                border: none;
                transform: none;
                width: 100%;
            }

            table {
                border-collapse: collapse;
                width: 100%;
            }

            :host(.pos-right) table, :host(.pos-left) table { width: 100%; }

            td, th {
                text-align: left;
                vertical-align: top;
                color: #eeeeee;
                padding: 2px 6px;
            }

            th {
                color: #aaaaaa;
                font-weight: 600;
                font-size: 12px;
                font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
            }

            tr:nth-child(even) {
                background-color: rgba(255, 255, 255, 0.02);
            }

            :host(.pos-right) .infobox tr, :host(.pos-left) .infobox tr {
                display: block;
            }

            :host(.pos-right) .infobox th, :host(.pos-left) .infobox th {
                background-color: transparent;
                width: 100%;
                display: block;
                padding-bottom: 0;
                border: none;
                color: #aaaaaa;
                font-size: 12px;
                word-break: break-all;
                overflow-wrap: anywhere;
            }
            :host(.pos-right) .infobox td, :host(.pos-left) .infobox td {
                width: 100%;
                display: block;
                padding-bottom: 8px;
                color: #eeeeee;
                border: none;
                word-break: break-all;
                overflow-wrap: anywhere;
            }

            :host(.pos-bottom) th, :host(.pos-top) th { border-right: 1px solid #333; }

            .nested-data {
                margin: 2px 0;
                background-color: rgba(0,0,0,0.2);
                border-radius: 4px;
                border: 1px solid #333;
                width: max-content;
                min-width: 100%;
            }

            :host(.pos-right) .nested-data, :host(.pos-left) .nested-data {
                width: 100%;
                min-width: 0;
            }

            .nested-data tr {
                border-bottom: 1px solid #2a2a2a;
                display: flex;
            }

            .nested-key {
                font-size: 11px;
                color: #999;
                padding: 2px 8px;
                flex: 0 0 130px;
                border-right: 1px solid #333;
                font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
                background-color: rgba(255,255,255,0.01);
                box-sizing: border-box;
            }

            .nested-val {
                padding: 2px 8px;
                flex: 1 1 auto;
                box-sizing: border-box;
            }

            a {
                text-decoration: none;
                color: #888888;
                transition: color 0.2s, background-color 0.2s;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 6px;
                border-radius: 4px;
            }

            a:hover {
                color: #ffffff;
                background-color: #444444;
            }

            .spacer {
                flex-grow: 1;
            }

            .icon {
                width: 16px;
                height: 16px;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
                fill: none;
                display: block;
            }

            .item-title {
                font-weight: bold;
                color: #4dabf7;
                display: block;
                margin-bottom: 4px;
                font-size: 13px;
                white-space: nowrap;
            }

            .sidebar-filter {
                display: none;
                padding: 10px;
                border-bottom: 1px solid #333333;
                background-color: #2a2a2a;
                position: sticky;
                top: 0;
                left: 0;
                right: 0;
                z-index: 20;
                box-sizing: border-box;
            }

            :host(.pos-right) .sidebar-filter, :host(.pos-left) .sidebar-filter {
                display: block;
                width: 100%;
            }

            .sidebar-filter input {
                width: 100%;
                background-color: #1a1a1a;
                border: 1px solid #444;
                color: #eee;
                padding: 6px 10px;
                border-radius: 4px;
                font-size: 12px;
                box-sizing: border-box;
            }

            .sidebar-filter input:focus {
                outline: none;
                border-color: #4dabf7;
            }

            .waterfall-container {
                width: 100%;
                min-width: 250px;
                position: relative;
                margin-top: 4px;
            }

            .waterfall-bar-bg {
                height: 12px;
                background-color: rgba(255, 255, 255, 0.05);
                border-radius: 2px;
                position: relative;
                overflow: hidden;
            }

            .waterfall-bar {
                height: 100%;
                background-color: #4dabf7;
                position: absolute;
                border-radius: 1px;
                min-width: 1px;
            }

            .waterfall-label {
                font-size: 10px;
                color: #888;
                margin-top: 2px;
                display: block;
                white-space: nowrap;
            }

            .toolbar-actions {
                display: flex !important;
                flex-direction: row !important;
                align-items: center;
                gap: 4px;
                cursor: default;
                border-left: 1px solid #333333;
                position: sticky;
                bottom: 0;
                left: 0;
                right: 0;
                background-color: #222222;
                z-index: 10;
                width: auto !important;
                min-width: 0 !important;
                padding: 5px 10px !important;
            }

            :host(.pos-right) .toolbar-actions, :host(.pos-left) .toolbar-actions {
                border-left: none;
                border-top: 1px solid #333333;
                width: 100% !important;
                justify-content: center;
                padding: 5px 0 !important;
            }

            #resize-handle {
                display: none;
                position: absolute;
                top: 0;
                bottom: 0;
                width: 4px;
                cursor: ew-resize;
                z-index: 2147483647;
                background-color: transparent;
            }

            #resize-handle:hover, #resize-handle.active { background-color: #4dabf7; }
            :host(.pos-left) #resize-handle { display: block; right: 0; }
            :host(.pos-right) #resize-handle { display: block; left: 0; }

            /* Value formatting */
            .val-string { color: #e9ecef; }
            .val-number { color: #ffd43b; }
            .val-boolean { color: #ff922b; }
            .val-null { color: #adb5bd; font-style: italic; }

            /* Pretty Print JSON */
            .val-json {
                margin: 0;
                font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
                font-size: 13px;
                color: #e9ecef;
                white-space: pre;
                background-color: rgba(0,0,0,0.2);
                padding: 8px;
                border-radius: 4px;
                border: 1px solid #333;
                width: max-content;
                min-width: 100%;
                box-sizing: border-box;
            }

            :host(.pos-right) .val-json, :host(.pos-left) .val-json {
                white-space: pre-wrap;
                word-break: break-all;
                width: 100%;
                min-width: 0;
            }
        </style>
        <div id="resize-handle"></div>
        <div id="debugtoolbar" class="flexbox-panel">
            <div class="sidebar-filter">
                <input type="text" id="sidebar-search" placeholder="Filter items...">
            </div>
            {% for rendering in collectorRenderings %}
                <div class="flexbox-item">
                    <span class="item-title">{{ rendering.title }}: {{ rendering.shortInformation }}</span>
                    {% if rendering.popupTable %}
                        <div class="infobox">
                            <table>
                                {% set total_duration = rendering.popupTable._meta.total_duration_ms|default(0) %}
                                {% for key, value in rendering.popupTable %}
                                    {% if key != '_meta' %}
                                        <tr>
                                            <th>{{ key|raw }}</th>
                                            <td>
                                                {% if value.start_ms is defined and value.duration_ms is defined and total_duration > 0 %}
                                                    <div class="waterfall-container">
                                                        <div class="waterfall-bar-bg">
                                                            <div class="waterfall-bar" style="left: {{ (value.start_ms / total_duration * 100)|round(2) }}%; width: {{ (value.duration_ms / total_duration * 100)|round(2) }}%;"></div>
                                                        </div>
                                                        <span class="waterfall-label">{{ value.duration_ms }}ms (at {{ value.start_ms }}ms)</span>
                                                    </div>
                                                {% else %}
                                                    {{ _self.render_data(value) }}
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </table>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}

            <div class="spacer"></div>

            <div class="flexbox-item toolbar-actions">
                <a href="#" id="pos-ccw" title="Move Counter-Clockwise">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </a>
                <a href="#" id="pos-opposite" title="Move to Opposite Side">
                    <svg class="icon" viewBox="0 0 24 24"><path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/></svg>
                </a>
                <a href="#" id="pos-cw" title="Move Clockwise">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                </a>
                <a href="#" id="close-btn" title="Close Debug Toolbar" onclick="this.getRootNode().host.remove(); document.body.style.margin = ''; return false;">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </a>
            </div>
        </div>
    </template>
</div>
<script>
    (function() {
        const requestId = '{{ requestId }}';
        const host = document.getElementById('blue-debug-toolbar-host-' + requestId);
        if (!host) return;

        if (!HTMLTemplateElement.prototype.hasOwnProperty('shadowRootMode')) {
            const template = host.querySelector('template[shadowrootmode]');
            if (template) {
                const mode = template.getAttribute('shadowrootmode');
                const shadowRoot = host.attachShadow({ mode });
                shadowRoot.appendChild(template.content);
                template.remove();
            }
        }

        const shadowRoot = host.shadowRoot;
        if (!shadowRoot) return;

        const positions = ['bottom', 'right', 'top', 'left'];
        const storageKeyPos = 'blue-debug-toolbar-pos';
        const storageKeyWidth = 'blue-debug-toolbar-width';

        function setPosition(pos) {
            host.classList.remove('pos-bottom', 'pos-top', 'pos-right', 'pos-left');
            host.classList.add('pos-' + pos);
            document.body.style.marginBottom = ''; document.body.style.marginTop = '';
            document.body.style.marginRight = ''; document.body.style.marginLeft = '';

            const navbar = document.querySelector('.navbar.is-fixed-top');
            if (navbar) { navbar.style.left = ''; navbar.style.right = ''; }

            if (pos === 'bottom') document.body.style.marginBottom = '35px';
            if (pos === 'top') document.body.style.marginTop = '35px';

            if (pos === 'right' || pos === 'left') {
                host.style.width = (localStorage.getItem(storageKeyWidth) || '350') + 'px';
            } else { host.style.width = ''; }

            localStorage.setItem(storageKeyPos, pos);
            updateBodyMargins();
        }

        function updateBodyMargins(overrideWidth) {
            const pos = localStorage.getItem(storageKeyPos);
            const width = overrideWidth || host.offsetWidth;
            const widthPx = width + 'px';
            const navbar = document.querySelector('.navbar.is-fixed-top');

            if (pos === 'right') {
                document.body.style.marginRight = widthPx;
                if (navbar) navbar.style.right = widthPx;
            }
            if (pos === 'left') {
                document.body.style.marginLeft = widthPx;
                if (navbar) navbar.style.left = widthPx;
            }
        }

        let currentPos = localStorage.getItem(storageKeyPos) || 'bottom';
        if (!positions.includes(currentPos)) currentPos = 'bottom';
        setPosition(currentPos);

        // Smart Positioning for Popups
        function ensureInViewport(item) {
            const infobox = item.querySelector('.infobox');
            if (!infobox) return;

            const pos = localStorage.getItem(storageKeyPos);
            if (pos === 'right' || pos === 'left') return;

            // Reset horizontal centering
            infobox.style.left = '50%';
            infobox.style.transform = 'translateX(-50%)';

            // Set precise vertical position based on the toolbar host's actual viewport position
            const hostRect = host.getBoundingClientRect();
            if (pos === 'bottom') {
                infobox.style.bottom = (window.innerHeight - hostRect.top) + 'px';
                infobox.style.top = '';
            } else {
                infobox.style.top = hostRect.bottom + 'px';
                infobox.style.bottom = '';
            }

            // Adjust horizontal position after layout is computed
            requestAnimationFrame(() => {
                const rect = infobox.getBoundingClientRect();
                const padding = 10;
                if (rect.left < padding) {
                    const offset = padding - rect.left;
                    infobox.style.transform = `translateX(calc(-50% + ${offset}px))`;
                } else if (rect.right > window.innerWidth - padding) {
                    const offset = (window.innerWidth - padding) - rect.right;
                    infobox.style.transform = `translateX(calc(-50% + ${offset}px))`;
                }
            });
        }

        // Interaction Logic for Horizontal Mode
        const items = shadowRoot.querySelectorAll('.flexbox-item:not(.toolbar-actions)');
        let hoverTimeout = null;

        items.forEach(item => {
            if (!item.querySelector('.infobox')) return;

            item.addEventListener('mouseenter', () => {
                const pos = localStorage.getItem(storageKeyPos);
                if (pos === 'right' || pos === 'left') return;

                if (hoverTimeout) clearTimeout(hoverTimeout);
                shadowRoot.querySelectorAll('.flexbox-item.active:not(.locked)').forEach(el => el.classList.remove('active'));
                item.classList.add('active');
                ensureInViewport(item);
            });

            item.addEventListener('mouseleave', () => {
                const pos = localStorage.getItem(storageKeyPos);
                if (pos === 'right' || pos === 'left' || item.classList.contains('locked')) return;

                hoverTimeout = setTimeout(() => {
                    item.classList.remove('active');
                }, 300);
            });

            item.addEventListener('click', (e) => {
                const pos = localStorage.getItem(storageKeyPos);
                if (pos === 'right' || pos === 'left' || e.target.closest('a')) return;

                const isLocked = item.classList.contains('locked');
                shadowRoot.querySelectorAll('.flexbox-item.locked').forEach(el => el.classList.remove('locked', 'active'));

                if (!isLocked) {
                    item.classList.add('locked', 'active');
                    ensureInViewport(item);
                } else {
                    item.classList.remove('locked', 'active');
                }
            });
        });

        // Resize & Position Logic
        const handle = shadowRoot.querySelector('#resize-handle');
        let isResizing = false;

        handle.addEventListener('mousedown', () => { isResizing = true; handle.classList.add('active'); document.body.style.cursor = 'ew-resize'; document.body.style.userSelect = 'none'; });
        window.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            let newWidth;
            const pos = localStorage.getItem(storageKeyPos);
            if (pos === 'left') newWidth = e.clientX;
            else if (pos === 'right') newWidth = window.innerWidth - e.clientX;
            if (newWidth >= 200 && newWidth <= window.innerWidth * 0.8) {
                host.style.width = newWidth + 'px';
                localStorage.setItem(storageKeyWidth, newWidth);
                updateBodyMargins(newWidth);
            }
        });
        window.addEventListener('mouseup', () => { if (isResizing) { isResizing = false; handle.classList.remove('active'); document.body.style.cursor = ''; document.body.style.userSelect = ''; } });

        const updatePosition = (offset) => {
            const currentIndex = positions.indexOf(currentPos);
            const nextIndex = (currentIndex + offset + positions.length) % positions.length;
            currentPos = positions[nextIndex];
            setPosition(currentPos);
        };

        shadowRoot.querySelector('#pos-ccw').addEventListener('click', (e) => { e.preventDefault(); updatePosition(1); });
        shadowRoot.querySelector('#pos-cw').addEventListener('click', (e) => { e.preventDefault(); updatePosition(-1); });
        shadowRoot.querySelector('#pos-opposite').addEventListener('click', (e) => { e.preventDefault(); updatePosition(2); });

        // Filtering Logic
        const sidebarSearch = shadowRoot.querySelector('#sidebar-search');
        sidebarSearch.addEventListener('input', () => {
            const query = sidebarSearch.value.toLowerCase();
            const items = shadowRoot.querySelectorAll('.flexbox-item:not(.toolbar-actions, .sidebar-filter)');

            items.forEach(item => {
                const title = item.querySelector('.item-title').textContent.toLowerCase();
                const rows = item.querySelectorAll('.infobox tr');
                let hasVisibleRow = false;

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.includes(query)) {
                        row.style.display = '';
                        hasVisibleRow = true;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (title.includes(query) || hasVisibleRow) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        });

        window.addEventListener('resize', () => {
            const pos = localStorage.getItem(storageKeyPos);
            if (pos === 'right' || pos === 'left') {
                updateBodyMargins();
            }
            shadowRoot.querySelectorAll('.flexbox-item.active').forEach(item => ensureInViewport(item));
        });
    })();
</script>
